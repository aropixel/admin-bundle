
<tr class="itemFile">
    <td>
        {% if form.vars.attachedFile is defined and form.vars.attachedFile and form.vars.attachedFile.file %}
            <span>{{ form.vars.attachedFile.title|raw }}</span>
        {% else %}
            <span></span>
        {% endif %}
        <div class="d-none">
            {{ form_widget(form) }}
        </div>
    </td>

    <td class="text-right">
        {% if form.vars.attachedFile is defined and form.vars.attachedFile and form.vars.attachedFile.file %}
            <a href="{{ aropixel_file_url(form.vars.attachedFile.file) }}" class="me-4">
                {{ ux_icon('lucide:download') }}
            </a>
        {% endif %}
        <a class="iconUnlinkFile">{{ ux_icon('lucide:unlink') }}</a>
    </td>
</tr>
