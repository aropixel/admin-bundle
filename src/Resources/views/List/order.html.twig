{% extends '@AropixelAdmin/List/table.html.twig' %}

{% block javascripts %}

    {{ parent() }}
    <script src="{{ asset('bundles/aropixeladmin/modules/jquery-ui/jquery-ui.min.js') }}"></script>

{% endblock %}

{% block header_top_right %}

    {% set baseroute = get_baseroute() %}

    {% if route_exists(baseroute ~ '_index') %}
        <a href="{{ path(baseroute ~ '_index') }}" class="btn btn-small btn-default">
            {{ ux_icon('lucide:list', {class: 'me-2'}) }}{% trans %}button.list{% endtrans %}
        </a>
    {% endif %}

    {# `Request::get()` was removed in Symfony 8; read the route from the attribute bag. #}
    {% if app.request.attributes.get('_route') != baseroute ~ '_new' and route_exists(baseroute ~ '_new') %}
        <a href="{{ path(baseroute ~ '_new') }}" class="btn btn-small btn-primary ms-3">
            {{ ux_icon('lucide:plus', {class: 'me-2'}) }}{% trans %}button.create{% endtrans %}
        </a>
    {% endif %}

{% endblock %}
