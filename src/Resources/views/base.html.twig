<!DOCTYPE html>
<html lang="fr">

    <head>

        <meta charset="UTF-8">
        <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
        <title>{% block meta_title %}{{ admin_client.name }} - Administration{% endblock %}</title>

        {% block stylesheets %}

        <!-- General CSS Files -->
        <link rel="stylesheet" href="{{ asset('bundles/aropixeladmin/css/foundations/_bootstrap-layer.css') }}">
        <link rel="stylesheet" href="{{ asset('bundles/aropixeladmin/modules/select2/dist/css/select2.min.css') }}">
        <link rel="stylesheet" href="{{ asset('bundles/aropixeladmin/modules/datatables/datatables.min.css') }}">
        <link rel="stylesheet" href="{{ asset('bundles/aropixeladmin/modules/datatables/DataTables-1.10.16/css/dataTables.bootstrap4.min.css') }}">
        <link rel="stylesheet" href="{{ asset('bundles/aropixeladmin/modules/datatables/Select-1.2.4/css/select.bootstrap4.min.css') }}">
        <link rel="stylesheet" href="{{ asset('bundles/aropixeladmin/modules/quilljs/quill.snow.css') }}">
        <!-- CSS Libraries -->

        {% endblock %}

        {% block theme_stylesheets %}

            <!-- Template CSS -->
            <link rel="stylesheet" href="{{ asset('bundles/aropixeladmin/css/style.css') }}">

            <!-- Awesome Font -->

        {% endblock %}

        {{ include('@AropixelAdmin/_theme-tokens.html.twig') }}

        {% block asset_manager %}
            {% if aropixel_asset_mapper_enabled %}
                {{ importmap('@aropixel/admin-bundle') }}
            {% endif %}
        {% endblock %}

    </head>

    {% set placeholderImgPath = admin_theme.images.placeholder_img_path %}
    {% set logoPath = admin_theme.logo.path %}
    {% set logoWidth = admin_theme.logo.width %}
    {% set logoMenuPath = admin_theme.logo.menu.path %}
    {% set logoMenuWidth = admin_theme.logo.menu.width %}
    {% set quickMenu = get_quick_menu() %}
    {% set adminMenu = aropixel_admin_render_menu() %}

    <body>

        {% block body_content %}
        <div id="app">

            <div class="main-wrapper-1">

                {{ include('@AropixelAdmin/Menu/fullscreen.html.twig') }}

                <!-- Main Content -->
                <div class="main-content main-content-fullscreen">

                    <section class="aro-section-header mt-3">

                        {% block header %}

                            <div class="header-top">

                                {% block header_top %}

                                    <div class="d-flex align-items-center justify-content-between">

                                        <div class="header-top-left">

                                            {% block header_top_left %}

                                                <h1>{% block header_title %}{% endblock %}</h1>

                                                <div class="aro-section-header-breadcrumb">
                                                    {% block header_breadcrumb %}{% endblock %}
                                                </div>

                                            {% endblock %}

                                        </div>

                                        <div class="header-top-right">
                                            {% block header_top_right %}{% endblock %}
                                        </div>

                                    </div>

                                {% endblock %}

                            </div>

                            <div class="header-bottom">
                                {% block header_bottom %}{% endblock %}
                            </div>

                        {% endblock %}

                    </section>

                    <section>

                        {% block body %}{% endblock %}

                    </section>

                </div>

                <footer class="main-footer">
                    <div class="main-footer-fullscreen">
                        {% block footer_left %}
                            <div class="footer-left">
                                {{ 'now'|date('Y') }} <a href="{{ admin_client.link }}">{{ admin_client.name }}</a> <div class="bullet"></div>  © <a href="{{ admin_copyright.link }}" target="_blank">{{ admin_copyright.name }}</a>
                            </div>
                        {% endblock %}

                        {% block footer_right %}
                            <div></div>
                        {% endblock %}
                    </div>
                </footer>

            </div>

        </div>
        {% endblock %}

        {% block javascripts %}
            <!-- General JS Scripts -->
            <script src="{{ asset('bundles/aropixeladmin/modules/jquery.min.js') }}"></script>
            <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/tooltip.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/bootstrap/js/bootstrap.min.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/nicescroll/jquery.nicescroll.min.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/moment.min.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/blockui.min.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/select2/dist/js/select2.min.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/datatables/datatables.min.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/datatables/plugins/date-euro.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/quilljs/quill.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/modules/gdpr/gdpr-password.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/js/datatable-core.js') }}"></script>
            <script type="module" src="{{ asset('bundles/aropixeladmin/js/fullscreen.js') }}"></script>
            <script type="module" src="{{ asset('bundles/aropixeladmin/js/security.js') }}"></script>
            <!-- JS Libraies -->
        {% endblock %}

        <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCollection" aria-labelledby="offcanvasCollectionLabel" style="width: 600px;">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasCollectionLabel">Edition</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
            </div>
        </div>

        <!-- Page Specific JS File -->

        {% block theme_javascripts %}

            <script>

                var image_translations = {
                    'select_image' : '{% trans %}Select image{% endtrans %}',
                };

            </script>

            {# Translated defaults for the JS dialogs (ConfirmDialog, ImageLightbox). Rendered
               here so all locales are covered; read as fallbacks when a caller passes none. #}
            <script>
                window.aroDialogI18n = {
                    title: {{ ('text.confirmation'|trans)|json_encode|raw }},
                    confirm: {{ ('text.confirm'|trans)|json_encode|raw }},
                    cancel: {{ ('text.cancel'|trans)|json_encode|raw }},
                    deleteTitle: {{ ('text.confirm_delete'|trans)|json_encode|raw }},
                    deleteDetail: {{ ('text.confirm_delete_detail'|trans)|json_encode|raw }},
                    deleteFile: {{ ('text.confirm_delete_file'|trans)|json_encode|raw }},
                    deleteLibraryFile: {{ ('text.confirm_delete_library_file'|trans)|json_encode|raw }},
                    deleteLibraryImage: {{ ('text.confirm_delete_library_image'|trans)|json_encode|raw }},
                    deleteGalleryImage: {{ ('text.confirm_delete_gallery_image'|trans)|json_encode|raw }},
                    deleteImageInUse: {{ ('text.delete_image_in_use'|trans)|json_encode|raw }},
                    deleteImageFailed: {{ ('text.delete_image_failed'|trans)|json_encode|raw }},
                    deleteFileInUse: {{ ('text.delete_file_in_use'|trans)|json_encode|raw }},
                    deleteFileFailed: {{ ('text.delete_file_failed'|trans)|json_encode|raw }},
                    save: {{ ('text.save'|trans)|json_encode|raw }},
                    close: {{ ('text.close'|trans)|json_encode|raw }},
                    openFile: {{ ('text.open_file'|trans)|json_encode|raw }},
                    mediaTitle: {{ ('library.datatabler.title'|trans)|json_encode|raw }},
                    titleSaveFailed: {{ ('text.title_save_failed'|trans)|json_encode|raw }},
                    online: {{ ('text.online'|trans)|json_encode|raw }},
                    offline: {{ ('text.offline'|trans)|json_encode|raw }},
                    setOnline: {{ ('text.set_online'|trans)|json_encode|raw }},
                    setOffline: {{ ('text.set_offline'|trans)|json_encode|raw }}
                };
            </script>

            {# Translated labels for the Quill editor — toolbar tooltips, the HTML source
               panel and the « new tab » checkbox of the link bubble. English fallbacks live
               in js/module/quill/quill-editor.js; window.aropixelQuillTooltips still wins. #}
            <script>
                window.aroQuillI18n = {
                    sourceTitle: {{ ('editor.source.title'|trans)|json_encode|raw }},
                    copy: {{ ('editor.source.copy'|trans)|json_encode|raw }},
                    copied: {{ ('editor.source.copied'|trans)|json_encode|raw }},
                    linkNewTab: {{ ('editor.link.new_tab'|trans)|json_encode|raw }},
                    tooltips: {
                        'button.ql-bold': {{ ('editor.tooltip.bold'|trans)|json_encode|raw }},
                        'button.ql-italic': {{ ('editor.tooltip.italic'|trans)|json_encode|raw }},
                        'button.ql-underline': {{ ('editor.tooltip.underline'|trans)|json_encode|raw }},
                        'button.ql-strike': {{ ('editor.tooltip.strike'|trans)|json_encode|raw }},
                        'button.ql-blockquote': {{ ('editor.tooltip.blockquote'|trans)|json_encode|raw }},
                        'button.ql-code-block': {{ ('editor.tooltip.code_block'|trans)|json_encode|raw }},
                        'button.ql-list[value="ordered"]': {{ ('editor.tooltip.list_ordered'|trans)|json_encode|raw }},
                        'button.ql-list[value="bullet"]': {{ ('editor.tooltip.list_bullet'|trans)|json_encode|raw }},
                        'button.ql-script[value="sub"]': {{ ('editor.tooltip.script_sub'|trans)|json_encode|raw }},
                        'button.ql-script[value="super"]': {{ ('editor.tooltip.script_super'|trans)|json_encode|raw }},
                        'button.ql-link': {{ ('editor.tooltip.link'|trans)|json_encode|raw }},
                        'button.ql-image': {{ ('editor.tooltip.image'|trans)|json_encode|raw }},
                        'button.ql-video': {{ ('editor.tooltip.video'|trans)|json_encode|raw }},
                        'button.ql-file': {{ ('editor.tooltip.file'|trans)|json_encode|raw }},
                        'button.ql-clean': {{ ('editor.tooltip.clean'|trans)|json_encode|raw }},
                        'button.ql-html': {{ ('editor.tooltip.html'|trans)|json_encode|raw }},
                        '.ql-picker.ql-header': {{ ('editor.tooltip.header'|trans)|json_encode|raw }},
                        '.ql-picker.ql-size': {{ ('editor.tooltip.size'|trans)|json_encode|raw }},
                        '.ql-picker.ql-align': {{ ('editor.tooltip.align'|trans)|json_encode|raw }},
                        '.ql-color-picker.ql-color': {{ ('editor.tooltip.color'|trans)|json_encode|raw }},
                        '.ql-color-picker.ql-background': {{ ('editor.tooltip.background'|trans)|json_encode|raw }}
                    }
                };
            </script>

            <!-- Template JS File -->
            <script type="module" src="{{ asset('bundles/aropixeladmin/js/app.js') }}"></script>
            <script type="module" src="{{ asset('bundles/aropixeladmin/js/datatable-init.js') }}"></script>
            <script type="module" src="{{ asset('bundles/aropixeladmin/js/images.js') }}"></script>
            <script type="module" src="{{ asset('bundles/aropixeladmin/js/files.js') }}"></script>
            <script type="module" src="{{ asset('bundles/aropixeladmin/js/translation.js') }}"></script>
            {# Les i18n sont rangées par langue (fr/, en/) : une locale régionalisée (fr_FR)
               ferait 404 et laisserait DataTables sur ses libellés anglais. #}
            {% set jsLocale = app.request.locale|split('_')|first %}
            <script src="{{ asset('bundles/aropixeladmin/js/i18n/' ~ jsLocale ~ '/app.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/js/i18n/' ~ jsLocale ~ '/datatable.js') }}"></script>
            <script src="{{ asset('bundles/aropixeladmin/js/custom.js') }}"></script>
            <script type="module">
                {# Must go through asset(): a hardcoded absolute path breaks any install
                   served from a sub-directory rather than the domain root. #}
                import { initImageManager } from '{{ asset('bundles/aropixeladmin/js/module/image-manager/launcher.js') }}';
                window.initImageManager = initImageManager;
            </script>
        {% endblock %}

    </body>

</html>
