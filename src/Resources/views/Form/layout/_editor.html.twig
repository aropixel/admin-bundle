{#
 # Rich-text editor (EditorType, QuillJS) — see doc/forms.md.
 #
 # The block was named `aropixel_editor_widget` until v3: the only bundle block that did not
 # carry the `aropixel_admin_` prefix. Normalised while v3 is still unreleased, because
 # renaming a form-theme block is a SILENT break once integrators override it (§10).
 #
 # Public: aropixel_admin_editor_widget
 #}

{% block aropixel_admin_editor_widget %}
    <div class="quill-editor-container">
        {% set providedDataClass = attr['data-class'] is defined and attr['data-class'] ? attr['data-class'] : null %}
        {% if providedDataClass %}
            {% set attr = attr|merge({
                'data-class': providedDataClass,
                'data-attach-path': get_image_editor_route(),
            }) %}
        {% elseif get_class(form.parent.vars.value) %}
            {% set attr = attr|merge({
                'data-class': get_class(form.parent.vars.value)|trim,
                'data-attach-path': get_image_editor_route(),
            }) %}
        {% else %}
            {% set attr = attr|merge({'data-attach-path': get_image_editor_route()}) %}
        {% endif %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' d-none')|trim}) %}
        {{- block('textarea_widget') -}}
        <div class="quill-editor" id="{{ id }}_quill" data-target="#{{ id }}" data-toolbar="{{ toolbar }}"></div>
    </div>
{% endblock %}
