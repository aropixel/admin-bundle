{#
 # Translatable fields — one pane per locale, toggled by the language switcher.
 # See doc/i18n.md.
 #
 # Public: aropixel_admin_translatable_row, aropixel_admin_translatable_widget
 # Internal: `.translatable-field` / `data-locale` are the contract with the switcher JS.
 #}

{% block aropixel_admin_translatable_row %}

    {% for child in form.children %}

        {% set label = child.parent.vars.label %}

        <div class="translatable-field translatable-field-{{ child.vars.label }} {% if child.vars.label == app.request.defaultLocale %}active{% endif %}" data-locale="{{ child.vars.label }}">
            {{ form_row(child, {label: label ~ ' (' ~ child.vars.label ~ ')'}) }}
        </div>

    {% endfor %}

{% endblock %}

{% block aropixel_admin_translatable_widget %}

    {% for child in form.children %}

        <div class="translatable-field translatable-field-{{ child.vars.label }} {% if child.vars.label == app.request.defaultLocale %}active{% endif %}" data-locale="{{ child.vars.label }}">
            {{ form_widget(child) }}
        </div>

    {% endfor %}

{% endblock %}
