{#
 # Image gallery widget (GalleryType) — see doc/gallery.md.
 #
 # Public: aropixel_admin_gallery_widget, aropixel_admin_gallery_image_row
 # Internal: the `data-im-*` attributes are the contract with js/module/image-manager/.
 #}

{% block aropixel_admin_gallery_widget -%}

    {{ enable_image_library_modal() }}
    {% set type = type is defined ? type : 'gallery' %}
    {% set entityField = field is defined ? field : 'gallery' %}
    {% set entityClass = get_class(form.parent.vars.value) %}

    <div class="im-manager"
         data-im-type="{{ type }}"
         data-im-library="{{ image_library }}"
         data-im-entity-class="{{ entityClass }}"
         data-im-attach-class="{{ image_class }}"
         data-im-attach-short-class="{{ image_class_short }}"
         data-im-crop-active="{{ crops is not empty ? get_class_available_crop_filters(image_class)|length > 1 : false }}"
         {% if accept is defined and accept %}data-im-accept="{{ accept }}"{% endif %}
            {% if max_size is defined and max_size %}data-im-max-size="{{ max_size }}"{% endif %}>

        {% if prototype is defined and not prototype.rendered %}
            {%- set attr = attr|merge({'data-prototype': form_row(prototype)}) -%}
        {% endif %}
        {%- set attr = attr|merge({class: 'row galleryContent'}) -%}

        {{- block('form_widget') -}}

        <div class="col-md-6 col-lg-4 mb-4 add-gallery-image" data-im-library-trigger="modal">
            <a data-bs-toggle="modal" data-bs-target="#modalLibrary">{{ ux_icon('lucide:plus') }}</a>
        </div>
    </div>
{% endblock %}

{% block aropixel_admin_gallery_row -%}
    {{- form_widget(form) -}}
{% endblock %}

{% block aropixel_admin_gallery_image_row -%}
    <div
            class="col-md-6 col-lg-4"
            data-title-label="{{ title_label }}"
            data-title-enabled="{{ title_enabled }}"
            data-description-label="{{ description_label }}"
            data-description-enabled="{{ description_enabled }}"
            data-link-label="{{ link_label }}"
            data-link-enabled="{{ link_enabled }}">
        {{ include('@AropixelAdmin/Image/Widget/gallery.html.twig', {form: form}) }}
    </div>
{% endblock %}

{% block aropixel_admin_gallery_crops_widget -%}
    {% if prototype is defined and not prototype.rendered %}
        {%- set attr = attr|merge({'data-prototype': form_row(prototype)}) -%}
    {% endif %}
    {{- block('form_widget') -}}
{% endblock %}

{% block aropixel_admin_gallery_crops_row -%}
    {{- form_widget(form) -}}
{%- endblock %}
